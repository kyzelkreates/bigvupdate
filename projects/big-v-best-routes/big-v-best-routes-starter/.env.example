# Big V's Best Routes — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# GraphHopper API key
# Get a free key at https://graphhopper.com/
# Without this key, the app uses a safe demo/fallback route.
VITE_GRAPHHOPPER_API_KEY=your_graphhopper_key_here
