# Big V's Best Routes — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# ── GraphHopper routing API key (required for live routing) ──────────────────
# Get a free key at https://graphhopper.com/
# Without this key, route calculation shows a setup-required state.
VITE_GRAPHHOPPER_API_KEY=your_graphhopper_key_here

# ── MapLibre GL JS map style URL (required for navigation map) ───────────────
# This must be a MapLibre GL-compatible style URL.
# Options:
#   - MapTiler:    https://api.maptiler.com/maps/streets/style.json?key=YOUR_MAPTILER_KEY
#   - Stadia Maps: https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json
#   - Self-hosted: Your own tile server style URL
#   - Dev only:    https://demotiles.maplibre.org/style.json  (low quality, dev use only)
#
# If not set, the app shows a setup-required warning.
# Do NOT use Google Maps SDK or Google tile URLs.
VITE_MAP_STYLE_URL=your_maplibre_osm_style_url_here

# ── Development fallback route (DEVELOPER TOOL ONLY) ─────────────────────────
# Set to true to enable a straight-line dev fallback route when no GH key is set.
# Default is false (product mode — shows setup-required state when key is missing).
# NEVER set this to true in production.
VITE_ENABLE_DEV_ROUTE_FALLBACK=false
